# Qishan static asset cache policy.
# UI scripts/styles use a short cache so wording fixes take effect promptly,
# instead of a browser holding an old i18n dictionary for hours.
/js/*
  Cache-Control: public, max-age=300, must-revalidate
/css/*
  Cache-Control: public, max-age=300, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
